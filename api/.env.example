# OpenHome API - Production Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials!

# =============================================================================
# REQUIRED - API Authentication
# =============================================================================
# Generate with: openssl rand -hex 32
API_KEY=

# =============================================================================
# REQUIRED - Database Configuration
# =============================================================================
# SQLite database paths (relative paths work for local dev, use absolute for Docker)
DATABASE_URL=sqlite:./data/app.db

# =============================================================================
# REQUIRED - NOOP push receiver
# =============================================================================
# Bearer token the NOOP phone app sends to the fixed push route /api/noop/push.
# Must differ from API_KEY (the phone should never hold the main key).
# Generate with: openssl rand -hex 32
NOOP_PUSH_TOKEN=

# Optional: push data lives in its own SQLite file. Defaults to noop.db next to
# DATABASE_URL (e.g. sqlite:./data/noop.db). Back it up: it is the only copy of
# received health data outside the phone.
# NOOP_DB_URL=sqlite:./data/noop.db

# =============================================================================
# OPTIONAL - AdGuard Home Integration
# =============================================================================
# Leave empty to disable AdGuard integration
ADGUARD_HOST=
ADGUARD_USERNAME=
ADGUARD_PASSWORD=

# Set to true if using self-signed certificates
ADGUARD_INSECURE_TLS=false

# =============================================================================
# OPTIONAL - SwitchBot Integration
# =============================================================================
# Base URL printed by the SwitchBot firmware, for example http://10.0.40.4
# Leave empty to disable SwitchBot integration
SWITCHBOT_BASE_URL=

# OPTIONAL - Weather (Open-Meteo free non-commercial API)
# Set both coordinates privately; leave both empty to disable weather.
# No provider key is needed. Never commit household coordinates.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=

# OPTIONAL - Wishlist destination for agent additions without an explicit owner/list.
# Create a Household User and Wishlist through the authenticated API first, then
# set the returned Wishlist ID privately. Unset means ask for the destination.
WISHLIST_DEFAULT_LIST_ID=

# OPTIONAL - Dashboard map origin (OpenFreeMap tiles; no provider key)
# Set both coordinates privately; leave both empty to show map setup instead.
# MAP_DEMO_ORIGIN=true centers on an unrelated Copenhagen demo for public
# evidence and cannot be combined with private coordinates.
MAP_ORIGIN_LATITUDE=
MAP_ORIGIN_LONGITUDE=
MAP_DEMO_ORIGIN=

# OPTIONAL - TMDB (free non-commercial search and metadata with attribution)
# API Read Access Token from TMDB account settings, held only by Axum.
# Leave empty to keep watchlists manual; never put this in dashboard VITE_* vars.
TMDB_READ_ACCESS_TOKEN=

# OPTIONAL - Immich selected photo albums (server root, without /api)
# Set all three together. IDs are a private allowlist of 1–8 albums.
# Read permissions: album.read and asset.view. No upload or library management.
# Only resized still images are served, never originals, EXIF or shared links.
IMMICH_URL=
IMMICH_API_KEY=
IMMICH_ALBUM_IDS=
