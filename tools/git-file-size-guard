#!/usr/bin/env bash
set -euo pipefail

max_tokens=5000
max_bytes=$((max_tokens * 4))

cd "$(git rev-parse --show-toplevel)"

if [[ ${1-} == --global ]] && grep -qs git-file-size-guard .pre-commit-config.yaml; then
  exit 0
fi

generated='(^|/)(node_modules|vendor|dist|build|out|target|\.sqlx|\.tanstack|__generated__|generated)/|(\.lock|\.lockb|-lock\.json|-lock\.yaml|\.sum|\.min\.(js|css)|\.map|\.snap|\.svg)$|\.gen\.|_generated\.|\.pb\.'

if [[ ${1-} == --tree ]]; then
  shift
  sized_files() {
    git ls-files -z --cached --others --exclude-standard --deduplicate -- "$@" |
      while IFS= read -r -d '' path; do
        [[ -f $path && ! -L $path ]] || continue
        printf '%s\0' "$path"
      done |
      xargs -0r stat --printf '%s\t%n\0' --
  }
  content() { cat -- "$1"; }
  numstat() { git diff --no-index --numstat -- /dev/null "./$1"; }
else
  set --
  sized_files() {
    git diff --cached --raw --no-abbrev -z --diff-filter=ACMRT --no-renames |
      while read -r -d '' _ mode _ oid _ && IFS= read -r -d '' path; do
        [[ $mode == 100* ]] || continue
        bytes=$(git cat-file -s "$oid")
        printf '%s\t%s\0' "$bytes" "$path"
      done
  }
  content() { git cat-file blob ":0:$1"; }
  empty_tree=$(git hash-object -t tree /dev/null)
  numstat() { git --literal-pathspecs diff --cached --numstat "$empty_tree" -- "$1"; }
fi

mapfile -d '' -t files < <(sized_files "$@")
wait "$!"

offenders=()
for file in "${files[@]}"; do
  bytes=${file%%$'\t'*}
  path=${file#*$'\t'}
  ((bytes <= max_bytes)) && continue
  [[ $path =~ $generated ]] && continue
  attrs=$(git check-attr file-size-guard linguist-generated linguist-vendored -- "$path")
  grep -qE ': (file-size-guard: unset|linguist-(generated|vendored): set)$' <<<"$attrs" && continue
  grep -qiE '@generated|do not edit|code generated' < <(content "$path" | head -n 5) && continue
  [[ $(numstat "$path") == -$'\t'* ]] && continue

  offenders+=("$path (~$((bytes / 4)) tokens)")
done

((${#offenders[@]} == 0)) && exit 0

{
  echo "Files over $max_tokens tokens (bytes/4):"
  printf '  %s\n' "${offenders[@]}"
  cat <<'MSG'

Split each file by responsibility, then stage the parts and commit again:
  1. List the file's top-level units (types, functions, components, sections).
  2. Group units that change together; each group becomes one new file named
     for its responsibility (e.g. parse.ts, render.ts, api/routes/<resource>.rs).
  3. Keep the original path as the entry point that re-exports or composes the
     parts, so callers and imports stay unchanged.
  4. Move tests next to the code they exercise.
  5. Run the repo's check command before committing.
Keep names, comments and formatting intact; the cap measures structure.
Generated files are skipped: mark one `linguist-generated` in .gitattributes.
MSG
} >&2
exit 1
